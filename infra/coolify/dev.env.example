# Environment variables untuk aplikasi "akur-api-dev" di Coolify (tab Environment Variables → Developer view).
# Salin isi file ini ke Coolify lalu isi nilainya. JANGAN commit nilai aslinya.
#
# Kunci dibuat sekali, simpan di password manager:
#   APP_KEY                  : php artisan key:generate --show
#   AKUR_PII_*_KEY (2 kunci) : php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
#   Kalau data lokal akan disalin ke dev (opsi B di README), APP_KEY dan kedua kunci PII WAJIB sama dengan backend/.env lokal.

APP_NAME=AKUR
APP_ENV=development
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-dev.rt05rw06larinda.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Ambil dari halaman database Postgres "Development" di Coolify (Postgres URL internal):
#   postgres://USER:PASSWORD@HOST:5432/DATABASE  → HOST = nama container (UUID), bukan IP publik.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=akur
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Web client ID OAuth Google (sama dengan lokal boleh).
GOOGLE_CLIENT_IDS=

AKUR_SESSION_TTL_DAYS=30
AKUR_SESSION_ABSOLUTE_TTL_DAYS=90
AKUR_SESSION_COOKIE_SECURE=true
# Origin Flutter web yang boleh memanggil API (dipisah koma, https saja).
AKUR_WEB_ORIGINS=https://dev.rt05rw06larinda.my.id

AKUR_PII_ENCRYPTION_KEY=
AKUR_PII_LOOKUP_KEY=
AKUR_REPORT_TIMEZONE=Asia/Jakarta
