APP_NAME=AKUR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=akur
DB_USERNAME=akur
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AKUR ---
# Client ID OAuth Google yang diterima sebagai `aud` ID token (pisahkan dengan koma).
# Android (Credential Manager) memakai Web client ID sebagai serverClientId, jadi biasanya cukup Web client ID.
GOOGLE_CLIENT_IDS=
# Umur sesi aplikasi (hari) dan nama cookie sesi web.
AKUR_SESSION_TTL_DAYS=30
AKUR_SESSION_COOKIE=akur_session
# Origin web yang diizinkan untuk request berbasis cookie (proteksi CSRF), pisahkan dengan koma.
AKUR_WEB_ORIGINS=http://localhost:8000

# Kunci enkripsi NIK/KK dan kunci HMAC lookup (WAJIB berbeda). Buat: php -r "echo base64_encode(random_bytes(32));"
AKUR_PII_ENCRYPTION_KEY=
AKUR_PII_LOOKUP_KEY=
