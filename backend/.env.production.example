# Salin ke backend/.env.production di VPS (jangan di-commit).
# Kredensial DB, APP_URL, dan AKUR_WEB_ORIGINS diisi oleh compose.yaml dari .env root.
APP_NAME=AKUR
APP_ENV=production
# Buat dengan: docker compose run --rm api php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Web client ID OAuth Google (Android memakai ID yang sama sebagai serverClientId).
GOOGLE_CLIENT_IDS=

AKUR_SESSION_TTL_DAYS=30
AKUR_SESSION_ABSOLUTE_TTL_DAYS=90
AKUR_SESSION_COOKIE_SECURE=true

# NIK/KK: kunci enkripsi dan kunci HMAC lookup (WAJIB berbeda, 32 byte acak base64).
# Buat: php -r "echo base64_encode(random_bytes(32));"  — simpan juga di password manager, BUKAN di backup.
# Rotasi kunci: lihat docs/security/field-encryption.md (AKUR_PII_KEYS + AKUR_PII_ACTIVE_KEY_ID).
AKUR_PII_ENCRYPTION_KEY=
AKUR_PII_LOOKUP_KEY=
AKUR_REPORT_TIMEZONE=Asia/Jakarta
